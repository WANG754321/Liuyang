<%@ page contentType="text/html;charset=UTF-8" %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="${pageContext.request.contextPath}/books">图书借阅系统</a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="${pageContext.request.contextPath}/books">图书列表</a>
            <% Integer role = (Integer) session.getAttribute("role"); if (role != null && role == 0) { %>
            <a class="nav-link" href="${pageContext.request.contextPath}/reader/center">个人中心</a>
            <% } %>
            <% if (role != null && role == 1) { %>
            <a class="nav-link" href="${pageContext.request.contextPath}/admin/users">用户管理</a>
            <a class="nav-link" href="${pageContext.request.contextPath}/admin/books">图书管理</a>
            <a class="nav-link" href="${pageContext.request.contextPath}/admin/borrow">借阅归还</a>
            <a class="nav-link" href="${pageContext.request.contextPath}/admin/overdue">逾期提醒</a>
            <% } %>
        </div>
        <span class="navbar-text text-white me-3">当前用户：<%= session.getAttribute("username") %></span>
        <a class="btn btn-outline-light btn-sm" href="${pageContext.request.contextPath}/logout">退出</a>
    </div>
</nav>
